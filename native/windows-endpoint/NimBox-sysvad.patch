+bool CMiniportWaveRTStream::NimTransfer(NimEndpointExchange* block)
+{
+    KIRQL irql;
+    KeAcquireSpinLock(&m_PositionSpinLock, &irql);
+    if (m_KsState != KSSTATE_RUN || !m_pDmaBuffer || !m_ulDmaBufferSize) {
+        KeReleaseSpinLock(&m_PositionSpinLock, irql); return false;
+    }
+    const ULONG bytes = NIM_ENDPOINT_FRAMES * 8;
+    ULONG amount = bytes;
+    if (!m_bCapture && m_bEoSReceived) {
+        if (m_bLastBufferRendered) amount=0;
+        else {
+            ULONG distance=(m_ulCurrentWritePosition + m_ulDmaBufferSize -
+                static_cast<ULONG>(m_ullWritePosition)) % m_ulDmaBufferSize;
+            amount=min(amount,distance);
+            if(amount==distance)m_bLastBufferRendered=TRUE;
+        }
+    }
+    ULONG offset=static_cast<ULONG>(m_ullWritePosition);
+    BYTE* audio=reinterpret_cast<BYTE*>(m_bCapture ? block->Capture : block->Render);
+    offset=nimRingTransfer(m_pDmaBuffer,m_ulDmaBufferSize,offset,audio,amount,m_bCapture!=FALSE);
+    m_ullPlayPosition=m_ullWritePosition=offset;
+    m_ullLinearPosition+=amount;
+    m_ullPresentationPosition+=bytes;
+    LARGE_INTEGER qpc=KeQueryPerformanceCounter(NULL);
+    m_NimQpc=qpc;
+    m_ullDmaTimeStamp=KSCONVERT_PERFORMANCE_TIME(m_ullPerformanceCounterFrequency.QuadPart,qpc);
+    bool notify=m_bLastBufferRendered!=FALSE;
+    if(m_ulNotificationsPerBuffer) {
+        ULONG packet=m_ulDmaBufferSize/m_ulNotificationsPerBuffer;
+        LONGLONG completed=static_cast<LONGLONG>(m_ullLinearPosition/packet);
+        notify=notify || completed!=m_llPacketCounter;
+        m_llPacketCounter=completed;
+    }
+    if(notify) {
+        for(auto entry=m_NotificationList.Flink;entry!=&m_NotificationList;entry=entry->Flink) {
+            auto item=CONTAINING_RECORD(entry,NotificationListEntry,ListEntry);
+            KeSetEvent(item->NotificationEvent,IO_NO_INCREMENT,FALSE);
+        }
+    }
+    KeReleaseSpinLock(&m_PositionSpinLock,irql); return true;
+}
