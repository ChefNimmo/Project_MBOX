; Native Windows audio development package. NOT the working ASIO 0.1.0 installer.
[Version]
Signature="$Windows NT$"
Class=MEDIA
ClassGUID={4d36e96c-e325-11ce-bfc1-08002be10318}
Provider=%Provider%
DriverVer=11/04/2026,0.2.0.2
CatalogFile=NimBoxAudio.cat
PnpLockDown=1

[Manufacturer]
%Provider%=Models,NTamd64.10.0...26100
[Models.NTamd64.10.0...26100]
%Device%=Install,Root\NimBoxAudio

[SourceDisksNames]
1=%Disk%
[SourceDisksFiles]
NimBoxAudio.sys=1
[DestinationDirs]
DriverCopy=13
[DriverCopy]
NimBoxAudio.sys

[Install.NT]
Include=ks.inf,wdmaudio.inf
Needs=KS.Registration,WDMAUDIO.Registration
CopyFiles=DriverCopy
AddReg=AudioRegistration
[AudioRegistration]
HKR,,AssociatedFilters,,"wdmaud"
HKR,,Driver,,NimBoxAudio.sys
HKR,Drivers,SubClasses,,"wave,mixer"
HKR,Drivers\wave\wdmaud.drv,Driver,,wdmaud.drv
HKR,Drivers\wave\wdmaud.drv,Description,,%Device%
HKR,Drivers\mixer\wdmaud.drv,Driver,,wdmaud.drv
HKR,Drivers\mixer\wdmaud.drv,Description,,%Device%

[Install.NT.Interfaces]
AddInterface=%Audio%,WaveSpeaker,RenderWave
AddInterface=%Render%,WaveSpeaker,RenderWave
AddInterface=%Realtime%,WaveSpeaker,RenderWave
AddInterface=%Audio%,TopologySpeaker,RenderTopo
AddInterface=%Topology%,TopologySpeaker,RenderTopo
AddInterface=%Audio%,WaveMicIn,CaptureWave
AddInterface=%Capture%,WaveMicIn,CaptureWave
AddInterface=%Realtime%,WaveMicIn,CaptureWave
AddInterface=%Audio%,TopologyMicIn,CaptureTopo
AddInterface=%Topology%,TopologyMicIn,CaptureTopo
[RenderWave]
AddReg=RenderWaveReg
[RenderWaveReg]
HKR,,CLSID,,%Proxy%
HKR,,FriendlyName,,%Playback%
[RenderTopo]
AddReg=RenderTopoReg
[RenderTopoReg]
HKR,,CLSID,,%Proxy%
HKR,,FriendlyName,,%Playback%
HKR,EP\0,%Association%,,%AnyNode%
HKR,EP\0,%EventDriven%,0x00010001,1
HKR,EP\0,%OEMFormat%,0x00000001,41,00,00,00,28,00,00,00,FE,FF,02,00,80,BB,00,00,00,DC,05,00,08,00,20,00,16,00,18,00,03,00,00,00,01,00,00,00,00,00,10,00,80,00,00,AA,00,38,9B,71
[CaptureWave]
AddReg=CaptureWaveReg
[CaptureWaveReg]
HKR,,CLSID,,%Proxy%
HKR,,FriendlyName,,%Recording%
[CaptureTopo]
AddReg=CaptureTopoReg
[CaptureTopoReg]
HKR,,CLSID,,%Proxy%
HKR,,FriendlyName,,%Recording%
HKR,EP\0,%Association%,,%AnyNode%
HKR,EP\0,%EventDriven%,0x00010001,1
HKR,EP\0,%OEMFormat%,0x00000001,41,00,00,00,28,00,00,00,FE,FF,02,00,80,BB,00,00,00,DC,05,00,08,00,20,00,16,00,18,00,03,00,00,00,01,00,00,00,00,00,10,00,80,00,00,AA,00,38,9B,71

[Install.NT.Services]
AddService=NimBoxAudioKernel,0x00000002,KernelService
[KernelService]
DisplayName=%Device%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%13%\NimBoxAudio.sys
[Install.NT.Wdf]
KmdfService=NimBoxAudioKernel,Wdf
[Wdf]
KmdfLibraryVersion=1.35
[Install.NT.HW]
AddReg=HardwareReg
[HardwareReg]
HKR,,DeviceType,0x10001,0x0000001D
HKR,,Security,,"D:P(A;;GA;;;SY)(A;;GRGWGX;;;BA)(A;;GRGWGX;;;WD)(A;;GRGWGX;;;RC)"

